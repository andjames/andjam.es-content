# Copy to .env.deploy and fill in the SFTP details from your host.
# This file is ignored by Git; use an SSH key or ssh-agent rather than a password.
DEPLOY_HOST=sftp.example.com
DEPLOY_USER=andrew
DEPLOY_PATH=/home/andrew/public_html
DEPLOY_PORT=22

# Optional: absolute path to a dedicated, password-protected SSH private key.
# DEPLOY_SSH_KEY=/Users/andrew/.ssh/andjames-content_ed25519
