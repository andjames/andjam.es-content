---
import BaseLayout from './BaseLayout.astro';
import Related from '../components/Related.astro';
import { formatDate, relatedEntries, type Entry } from '../lib/content';
import { site, typeLabels } from '../lib/site';
interface Props { entry: Entry; }
const { entry } = Astro.props;
const schemaType = entry.data.type === 'writing' ? 'Article' : entry.data.type === 'project' ? 'SoftwareApplication' : 'CreativeWork';
const jsonLd = { '@context': 'https://schema.org', '@type': schemaType, headline: entry.data.title, name: entry.data.title, description: entry.data.description, url: entry.data.canonical ?? new URL(Astro.url.pathname, site.url).toString(), datePublished: entry.data.date?.toISOString(), dateModified: entry.data.updated?.toISOString(), author: { '@type': 'Person', name: site.author.name, url: site.url }, ...(entry.data.image ? { image: new URL(entry.data.image, site.url).toString() } : {}) };
const related = await relatedEntries(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description} canonical={entry.data.canonical} image={entry.data.image} imageAlt={entry.data.imageAlt} jsonLd={jsonLd}>
  <article class:list={["entry", `entry--${entry.data.type}`]}>
    <header class="entry-header"><p class="eyebrow">{typeLabels[entry.data.type]}{entry.data.status && ` · ${entry.data.status}`}</p><h1>{entry.data.title}</h1><p class="dek">{entry.data.description}</p>
    {entry.data.date && <p class="date"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>{entry.data.updated && ` · Updated ${formatDate(entry.data.updated)}`}</p>}
    {entry.data.type === 'project' && <dl class="project-meta">{entry.data.role && <><dt>Role</dt><dd>{entry.data.role}</dd></>}{entry.data.technologies.length > 0 && <><dt>Technologies</dt><dd>{entry.data.technologies.join(', ')}</dd></>}</dl>}
    </header><div class="prose"><slot /></div>
    {entry.data.links.length > 0 && <section class="links"><h2>Links</h2><ul>{entry.data.links.map(link => <li><a href={link.url}>{link.label}</a></li>)}</ul></section>}
    <Related entries={related} />
  </article>
</BaseLayout>
